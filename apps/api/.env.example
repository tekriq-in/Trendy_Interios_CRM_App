MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/trendy-interiors
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be different from each other and >= 32 chars in production (enforced at startup).
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

DRIVE_PROVIDER=cloudinary        # mock | cloudinary

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

WHATSAPP_PROVIDER=mock
# Only required when WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Random secret you set — must match the Verify Token in Meta App Dashboard
WA_VERIFY_TOKEN=
# App Secret from Meta App Dashboard — used to verify X-Hub-Signature-256
META_APP_SECRET=

FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# LLM for client message generation (gemini | groq | mock)
LLM_PROVIDER=mock
# Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get free key at https://console.groq.com
GROQ_API_KEY=

# Initial MD super-admin. Production refuses to start with the default password.
SEED_MD_EMAIL=admin@trendyinterios.in
SEED_MD_PASSWORD=ChangeMe123!

PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
# Only for running the production images locally (docker compose). With
# NODE_ENV=production, localhost origins are rejected unless this is true.
# Never set it on Render.
# ALLOW_LOCALHOST_CORS=true

# Rate limiting (requests per 60s window). Raise in dev if running E2E tests.
THROTTLE_LIMIT_GLOBAL=100
