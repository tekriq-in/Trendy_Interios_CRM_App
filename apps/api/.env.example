MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/trendy-interiors
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

DRIVE_PROVIDER=mock              # mock | cloudinary | google

# ── Cloudinary (recommended) ─────────────────────────────────────────────────
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Cloud Storage (legacy) ────────────────────────────────────────────
# Only required when DRIVE_PROVIDER=google
# Paste the FULL service account JSON as a single minified line
GOOGLE_DRIVE_SERVICE_ACCOUNT=
# GCS bucket name — create at console.cloud.google.com/storage
GOOGLE_DRIVE_BUCKET_NAME=

WHATSAPP_PROVIDER=mock
# Only required when WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Random secret you set — must match the Verify Token in Meta App Dashboard
WA_VERIFY_TOKEN=

FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# LLM for client message generation (gemini | groq | mock)
LLM_PROVIDER=mock
# Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get free key at https://console.groq.com
GROQ_API_KEY=

SEED_MD_EMAIL=admin@trendyinterios.in
SEED_MD_PASSWORD=ChangeMe123!

PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Rate limiting (requests per 60s window). Raise in dev if running E2E tests.
THROTTLE_LIMIT_GLOBAL=100
